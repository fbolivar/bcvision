# ============================================================
# FirewallIQ — Variables de entorno
# Copiar a .env.local y completar los valores
# NUNCA commitear .env.local
# ============================================================

# ── Supabase ─────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Site URL ─────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Anthropic Claude API ─────────────────────────────────────
# Para generación de reportes ejecutivos con IA
ANTHROPIC_API_KEY=sk-ant-...

# ── Resend (emails transaccionales) ──────────────────────────
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@firewalliq.com

# ── Syslog Listener ──────────────────────────────────────────
# Variables para el proceso separado syslog-listener/
SYSLOG_UDP_PORT=514
SYSLOG_TCP_PORT=514
SYSLOG_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SYSLOG_SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── GeoIP (MaxMind) — opcional para país de origen ───────────
# Descargar base de datos de https://www.maxmind.com
MAXMIND_LICENSE_KEY=
GEOIP_DB_PATH=./data/GeoLite2-Country.mmdb

# ── Threat Intelligence — opcional ───────────────────────────
# API keys para feeds de amenazas (AbuseIPDB, VirusTotal)
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=
