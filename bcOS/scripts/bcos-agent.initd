#!/sbin/openrc-run

description="bcOS Syslog Agent"
command="/usr/bin/node"
command_args="/opt/bcos-agent/dist/index.js"
command_user="root"
command_background="yes"
pidfile="/run/bcos-agent.pid"
stdout_log="/var/log/bcos-agent.log"
stderr_log="/var/log/bcos-agent.log"

depend() {
    need net
    after firewall
}

start_pre() {
    checkpath --directory --owner root:root --mode 0755 /etc/bcvision
    checkpath --directory --owner root:root --mode 0755 /var/log
    if [ ! -f /etc/bcvision/config.json ]; then
        echo '{}' > /etc/bcvision/config.json
    fi
}
